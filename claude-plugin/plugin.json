{
  "name": "btl",
  "version": "0.1.3",
  "displayName": "btl - Background Task Manager",
  "description": "Bottle up your processes - background and auto-replace long-running commands like dev servers, watchers, and builds",
  "author": "Luke Oliff <luke@lukeoliff.com>",
  "repository": "https://github.com/lukeocodes/btl",
  "license": "MIT",
  "keywords": [
    "process-management",
    "background",
    "dev-server",
    "task-manager",
    "daemon"
  ],
  "categories": [
    "development-tools",
    "process-management"
  ],
  "requirements": {
    "btl": {
      "type": "binary",
      "install": {
        "cargo": "rust-btl"
      },
      "check": "btl --version"
    }
  },
  "skills": [
    "skills/using-btl"
  ]
}
